{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Auto Install Dependencies",
			"type": "shell",
			"command": "node -e \"if (!require('fs').existsSync('node_modules')) process.exit(1);\"",
			"on": {
				"active": true
			},
			"runOptions": {
				"runOn": "folderOpen"
			},
			"problemMatcher": [],
			"group": "none",
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"windows": {
				"command": "if not exist node_modules npm install"
			},
			"osx": {
				"command": "[ -d node_modules ] || npm install"
			},
			"linux": {
				"command": "[ -d node_modules ] || npm install"
			}
		}
	]
}
